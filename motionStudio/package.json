    "@remotion/lambda": "4.0.488",
    "@remotion/media": "4.0.488",
    "@remotion/player": "^4.0.488",
    "@supabase/supabase-js": "^2.110.2",
    "@tailwindcss/vite": "^4.3.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "driver.js": "1.8.0",
