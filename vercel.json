{
  "buildCommand": "cd motionStudio && npm install && npm run build",
  "outputDirectory": "motionStudio/dist",
  "installCommand": "npm install --prefix api",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/|assets/|favicon\\.svg|icons\\.svg|version\\.json).*)", "destination": "/index.html" }
  ]
}
